      "refersTo": "button-icon",
      "description": "Compact icon control with an accessible name.",
      "html": "<button class=\"ds-icon-button\" aria-label=\"Refresh\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8\"/><path d=\"M21 3v5h-5\"/><path d=\"M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16\"/><path d=\"M8 16H3v5\"/></svg></button>",
      "css": ".ds-icon-button{display:inline-flex;align-items:center;justify-content:center;width:36px;height:36px;border:1px solid var(--line,#e3e7ee);border-radius:6px;background:var(--paper,#fff);color:var(--muted,#627084);cursor:pointer;transition:background-color .16s ease,color .16s ease,border-color .16s ease;}.ds-icon-button:hover{background:var(--blue-soft,#edf2ff);color:var(--blue,#2456d5)}.ds-icon-button:focus-visible{outline:3px solid var(--focus,#7596ef);outline-offset:3px;} @media(prefers-reduced-motion:reduce){[class^=\"ds-\"]{transition:none;animation:none}}"
    },
    {
      "name": "Backend address",
      "kind": "input",
      "refersTo": "input-address",
      "description": "Monospaced address field with a visible label.",
      "html": "<label class=\"ds-address-label\" for=\"ds-address\">HTTP API URL</label><input class=\"ds-address\" id=\"ds-address\" type=\"url\" value=\"http://192.168.1.20:3000\" spellcheck=\"false\">",
      "css": ".ds-address-label{font-family:\"Manrope Variable\",sans-serif;display:block;font-size:12.32px;font-weight:650;margin-bottom:8px;color:var(--ink,#263144)}.ds-address{font-family:var(--mono,\"IBM Plex Mono\",monospace);font-size:11.62px;width:calc(100% - 26px);padding:12px;border:1px solid #cfd7e4;border-radius:6px;color:var(--ink,#263144);background:var(--paper,#fff);caret-color:var(--blue,#2456d5);transition:background-color .16s ease,color .16s ease,border-color .16s ease;}.ds-address:focus-visible{outline:3px solid var(--focus,#7596ef);outline-offset:3px;} @media(prefers-reduced-motion:reduce){[class^=\"ds-\"]{transition:none;animation:none}}"
    },
    {
      "name": "Navigation item",
      "kind": "nav",
      "refersTo": "nav-active",
      "description": "Current destination uses cobalt text and a pale selected surface.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Preview navigation\"><a class=\"ds-nav-link\" href=\"#overview\" aria-current=\"page\">Machine overview</a><a class=\"ds-nav-link\" href=\"#registers\">Register maps</a></nav>",
      "css": ".ds-nav{display:flex;flex-direction:column;gap:7px}.ds-nav-link{font-family:\"Manrope Variable\",sans-serif;display:flex;align-items:center;height:45px;padding:0 13px;border-radius:7px;text-decoration:none;font-size:12.88px;font-weight:650;color:var(--muted,#627084);transition:background-color .16s ease,color .16s ease,border-color .16s ease;}.ds-nav-link:hover{background:var(--ground,#f7f8fa);color:var(--ink,#263144)}.ds-nav-link[aria-current]{background:var(--blue-soft,#edf2ff);color:var(--blue,#2456d5)}.ds-nav-link:focus-visible{outline:3px solid var(--focus,#7596ef);outline-offset:3px;} @media(prefers-reduced-motion:reduce){[class^=\"ds-\"]{transition:none;animation:none}}"
    },
    {
      "name": "Gateway status",
      "kind": "chip",
      "refersTo": "badge-online",
      "description": "Status is communicated by words and color.",
      "html": "<span class=\"ds-badge\"><span class=\"ds-dot\"></span>Online</span><span class=\"ds-badge ds-caution\"><span class=\"ds-dot\"></span>Unverified</span>",
      "css": ".ds-badge{font-family:\"Manrope Variable\",sans-serif;display:inline-flex;align-items:center;gap:6px;white-space:nowrap;padding:5px 9px;border-radius:5px;font-size:10.08px;font-weight:650;background:#eaf6ef;color:#176c4b}.ds-caution{background:#fff5e5;color:#8a5214}.ds-dot{display:inline-block;width:6px;height:6px;border-radius:50%;background:currentColor} @media(prefers-reduced-motion:reduce){[class^=\"ds-\"]{transition:none;animation:none}}"
    },
    {
      "name": "Working panel",
      "kind": "card",
      "refersTo": "panel",
      "description": "Flat working surface with a compact header.",
      "html": "<section class=\"ds-panel\"><div class=\"ds-panel-heading\"><h2 class=\"ds-panel-title\">Data context</h2></div><p class=\"ds-panel-note\">Per-reading diagnostics and the last telemetry timestamp determine measurement freshness.</p></section>",
      "css": ".ds-panel{font-family:\"Manrope Variable\",sans-serif;background:var(--paper,#fff);color:var(--ink,#263144);border:1px solid var(--line,#e3e7ee);border-radius:var(--radius,12px);overflow:hidden;min-width:0}.ds-panel-heading{padding:22px 24px}.ds-panel-title{margin:0;font-size:15.4px;letter-spacing:-.015em;font-weight:750}.ds-panel-note{margin:0;padding:13px 24px;background:#fcfcfd;border-top:1px solid var(--line,#e3e7ee);color:var(--muted,#627084);font-size:10.5px;line-height:1.65} @media(prefers-reduced-motion:reduce){[class^=\"ds-\"]{transition:none;animation:none}}"
    },
    {
      "name": "Measurement",
      "kind": "card",
      "refersTo": "reading",
      "description": "Large reported value, quiet unit, and register source; illustrative preview.",
      "html": "<article class=\"ds-reading\"><div class=\"ds-reading-label\">Temperature</div><div class=\"ds-reading-value\">120<span class=\"ds-reading-unit\">\u00b0C</span></div><div class=\"ds-reading-source\">Register 0 \u00b7 UINT16 \u00b7 Sample</div></article>",
      "css": ".ds-reading{font-family:\"Manrope Variable\",sans-serif;background:var(--paper,#fff);color:var(--ink,#263144);border:1px solid var(--line,#e3e7ee);border-radius:12px;padding:22px 24px}.ds-reading-label{font-size:12.18px;color:var(--muted,#627084)}.ds-reading-value{display:flex;align-items:baseline;gap:9px;margin:15px 0 20px;font-size:37.1px;line-height:1.3;letter-spacing:-.04em;font-weight:650;font-variant-numeric:tabular-nums;flex-wrap:wrap}.ds-reading-unit{font-size:13.16px;letter-spacing:0;font-weight:500;color:var(--muted,#627084)}.ds-reading-source{font-size:10.08px;color:var(--muted,#627084)} @media(prefers-reduced-motion:reduce){[class^=\"ds-\"]{transition:none;animation:none}}"
    },
    {
      "name": "Register reference",
      "kind": "custom",
      "refersTo": "register-table",
      "description": "Technical columns stay inspectable in a focusable scroll region; illustrative preview.",
      "html": "<div class=\"ds-table-scroll\" tabindex=\"0\" role=\"region\" aria-label=\"Sample register reference\"><table class=\"ds-table\"><thead><tr><th>Metric</th><th>Raw address</th><th>Data type</th><th>Scale</th><th>Reported value</th></tr></thead><tbody><tr><th scope=\"row\">Temperature</th><td>0</td><td>UINT16</td><td>\u00d7 0.1</td><td>120 \u00b0C</td></tr></tbody></table></div>",
      "css": ".ds-table-scroll{overflow:auto}.ds-table-scroll:focus-visible{outline:3px solid var(--focus,#7596ef);outline-offset:3px;}.ds-table{font-family:\"Manrope Variable\",sans-serif;border-collapse:collapse;width:100%;min-width:620px;text-align:left;color:var(--ink,#263144)}.ds-table thead th{background:#f8f9fb;border-top:1px solid var(--line,#e3e7ee);border-bottom:1px solid var(--line,#e3e7ee);padding:12px 18px;font-size:10.64px;font-weight:600;color:var(--muted,#627084);white-space:nowrap}.ds-table tbody th,.ds-table td{padding:17px 18px;border-bottom:1px solid #edf0f5;font-size:11.76px}.ds-table td{font-family:var(--mono,\"IBM Plex Mono\",monospace);font-variant-numeric:tabular-nums} @media(prefers-reduced-motion:reduce){[class^=\"ds-\"]{transition:none;animation:none}}"
    }
  ],
  "narrative": {
    "northStar": "Maintenance Reference Sheet",
    "overview": "Legacy-link uses a light, concise, readable operations workspace. Cool gray surrounds white working surfaces; restrained cobalt identifies navigation and actions. Fine table rules, readable measurements, and monospaced identifiers connect an overview to its underlying register data.\n\nThe implemented world is code-first: no image composition or decorative imagery is required. Manrope supplies the interface voice, while IBM Plex Mono separates addresses, types, and machine identifiers. The interface and repository artifacts use English.",
    "keyCharacteristics": [
      "Flat white surfaces on a cool gray workspace.",
      "Cobalt actions and explicit semantic status labels.",
      "Compact tables with inspectable identifiers and numeric columns.",
      "Responsive navigation and stacked mobile measurements."
    ],
    "rules": [
      {
        "name": "The State Has Words Rule",
        "body": "Pair semantic color with a visible state label or explanatory message. A colored dot alone does not establish gateway health or measurement freshness.",
        "section": "colors"
      },
      {
        "name": "The Numeric Trace Rule",
        "body": "Use monospaced, tabular numerals for technical identifiers and table values; keep large measurement values in the interface family with tabular numerals.",
        "section": "typography"
      },
      {
        "name": "The Flat Surface Rule",
        "body": "Separate working regions with tone, fine borders, and spacing. The implemented system has no box shadows.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do reuse cobalt for actions and selected navigation, and pair status colors with text.",
      "Do retain source, stale-data, and sample-mode context wherever readings appear.",
      "Do preserve visible keyboard focus, native button semantics, labeled fields, and reduced-motion support.",
      "Do keep register columns within a keyboard-focusable horizontal scroll region on small screens.",
      "Do display gateway-reported values without applying the catalog scale again."
    ],
    "donts": [
      "Don't present backend contact time as an individual measurement timestamp.",
      "Don't present a catalog, signal-path diagram, or successful HTTP response as proof of hardware state.",
      "Don't imply alarm history or historical charts are available, or treat pending configuration commands as confirmed device state.",
      "Don't infer active alarms from configured thresholds or silently replace live data with sample data."
    ]
  }
}
