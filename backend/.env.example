# MQTT broker (config của Huy: allow_anonymous false -> buoc phai co user/pass)
MQTT_URL=mqtt://localhost:1883
MQTT_USERNAME=legacy_admin
MQTT_PASSWORD=change_me

# Tien to dinh danh client tren broker. Backend tu them PID phia sau de moi
# tien trinh co mot ID rieng, tranh hai instance gianh nhau gay vong lap
# reconnect vo tan (broker log se ghi "session taken over").
# neu sau nay doi sang clean: false de broker xep hang message luc
# backend chet, thi clientId PHAI CO DINH — khong duoc them PID.
MQTT_CLIENT_ID=legacy-link-backend


MQTT_QOS=2