# MQTT broker (config của Huy: allow_anonymous false -> buoc phai co user/pass)
MQTT_URL=mqtt://localhost:1883
MQTT_USERNAME=backend
MQTT_PASSWORD=replace_with_backend_mqtt_password

# ID consumer giữ nguyên qua các lần chạy (clean=false) để broker nhận ra phiên cũ.
# Mỗi consumer chạy đồng thời phải dùng ID khác nhau.
# Firmware QoS0 vẫn cần hàng đợi và ACK sau lưu database để phục hồi dữ liệu.
MQTT_CLIENT_ID=legacy-link-backend


MQTT_QOS=2

# Postgres. Neu chay bang Docker nhu trong README thi gia tri nay dung duoc ngay;
# chi can doi mat khau cho khop voi luc tao container.
DATABASE_URL=postgresql://legacy_admin:replace_with_db_password@localhost:5432/legacy_link

# Địa chỉ/cổng HTTP API. Cổng 0 chỉ dành cho test để chọn cổng trống tự động.
HTTP_HOST=0.0.0.0
HTTP_PORT=3000

# C12: số việc đang chạy / tổng số việc giữ trong RAM / kích thước payload.
INGESTION_CONCURRENCY=4
INGESTION_CAPACITY=256
MQTT_MAX_PAYLOAD_BYTES=16384
SHUTDOWN_TIMEOUT_MS=15000
# C15: tạo HAI token riêng bằng: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_READ_TOKEN=
API_WRITE_TOKEN=
# Phân cách nhiều origin bằng dấu phẩy; cập nhật URL này nếu tunnel ngrok đổi.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://vineyard-fifteen-elusive.ngrok-free.dev
# Chỉ dùng thử local: API_AUTH_DISABLED=true và HTTP_HOST=127.0.0.1; production không cho tắt.
API_AUTH_DISABLED=false

# TLS: CA riêng thì điền đường dẫn PEM; CA công cộng được Node tin thì có thể để trống.
MQTT_TLS_CA_FILE=
# Production mặc định yêu cầu mqtts; chỉ true cho chặng MQTT nội bộ đã được kiểm soát.
MQTT_ALLOW_PLAINTEXT=false

# Chính sách dọn lịch sử: lệnh mặc định dry-run, thêm --apply mới xóa theo lô.
TELEMETRY_RETENTION_DAYS=30
ALARM_RETENTION_DAYS=90
# Docker network chung của backend và hạ tầng; đổi cho đúng tên thực tế.
LEGACY_NETWORK=legacy-link-net



# AI chỉ chạy phía server. Không đặt key vào frontend hoặc commit key thật.
GEMINI_API_KEY=
# Chọn model có sẵn trong AI Studio của project; đổi được mà không sửa code.
GEMINI_MODEL=gemini-3.5-flash-lite
