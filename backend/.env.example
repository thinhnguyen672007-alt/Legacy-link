# MQTT broker (config của Huy: allow_anonymous false -> buoc phai co user/pass)
MQTT_URL=mqtt://localhost:1883
MQTT_USERNAME=legacy_admin
MQTT_PASSWORD=legacy_secret_2026

# Stable consumer ID, preserved across restarts (clean=false).
# Each simultaneously running consumer must use a DIFFERENT ID.
# QoS0 firmware still needs its own queue + application ACK for recovery.
MQTT_CLIENT_ID=legacy-link-backend


MQTT_QOS=2

# Postgres. Neu chay bang Docker nhu trong README thi gia tri nay dung duoc ngay;
# chi can doi mat khau cho khop voi luc tao container.
DATABASE_URL=postgres://legacy_admin:change_me@localhost:5432/legacy_link

# HTTP API (0 chooses an ephemeral port for integration tests).
HTTP_HOST=0.0.0.0
HTTP_PORT=3000
