{
  "deviceId": "esp32-03",
  "deviceName": "CNC so 3",
  "protocol": "MODBUS_RTU",
  "baudRate": 9600,
  "parity": "NONE",
  "stopBits": 1,
  "slaveId": 1,
  "samplingIntervalMs": 1000,
  "registerMap": [
    {"key": "speed", "address": 1, "functionCode": 3, "dataType": "UINT16", "scale": 1.0, "unit": "rpm"},
    {"key": "torque", "address": 5, "functionCode": 3, "dataType": "UINT16", "scale": 0.1, "unit": "Nm"},
    {"key": "temperature", "address": 51, "functionCode": 3, "dataType": "INT16", "scale": 0.1, "unit": "C"}
  ]
}
