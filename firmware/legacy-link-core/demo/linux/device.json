{
  "deviceId": "D1-DEMO-01",
  "deviceName": "Legacy PLC simulator",
  "protocol": "MODBUS_RTU",
  "baudRate": 9600,
  "parity": "NONE",
  "stopBits": 1,
  "slaveId": 1,
  "samplingIntervalMs": 1000,
  "registerMap": [
    {
      "key": "temperature", "address": 0, "functionCode": 3,
      "dataType": "INT16", "scale": 0.1, "unit": "C",
      "alarm": {
        "threshold": 90, "hysteresis": 3, "criticalThreshold": 100,
        "code": "OVERHEAT", "severity": "high"
      }
    },
    {"key": "current", "address": 1, "functionCode": 3, "dataType": "UINT16", "scale": 0.01, "unit": "A"},
    {"key": "rpm", "address": 2, "functionCode": 3, "dataType": "UINT16", "scale": 1, "unit": "rpm"}
  ]
}
