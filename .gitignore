# PlatformIO
.pio/

# Local VS Code and editor state
.vscode/*.log
.vscode/ipch/
.vscode/.browse.c_cpp.db*

# JavaScript dependencies and build output
node_modules/
dist/
build/
coverage/

# Python environments and caches
.venv/
venv/
__pycache__/
*.py[cod]

# Local configuration and secrets
.env
.env.*
!.env.example

# Operating system files
.DS_Store
desktop/assets/icon.icns
desktop/assets/icon.iconset/
Thumbs.db

# Mosquitto runtime data (generated by Docker container)
infrastructure/mosquitto/data/mosquitto.db
infrastructure/mosquitto/data/data
infrastructure/mosquitto/log/mosquitto.log
infrastructure/mosquitto/config/passwd

# PostgreSQL runtime data (generated by Docker container)
backend/pgdata/

# Submission media: videos, slides and installers are large binaries.
# Publish them as release assets or links instead of tracking in git.
output/submission/*.mp4
output/submission/*.pptx
output/submission/*.pdf

