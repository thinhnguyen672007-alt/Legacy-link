# ==============================================================================
# [NOTE] Environment Configuration Template (.env.example)
#
# Role: Centralized environment variables for Docker Compose and helper scripts.
#
# Usage:
#   1. Copy this file to create your local `.env`:
#      cp .env.example .env
#   2. Adjust values if needed (ports, container names, dev credentials).
#   3. Never commit `.env` to Git (it is automatically ignored).
# ==============================================================================

# --- MQTT Broker Service ---
# Profile mặc định cho docker compose: "broker" chỉ bật broker + PostgreSQL,
# "full" bật cả consumer + API + gateway. Ghi đè khi chạy, ví dụ:
#   COMPOSE_PROFILES=broker ./scripts/setup.sh
COMPOSE_PROFILES=full

# Port exposed on the host machine for external clients (ESP32, simulators)
MQTT_PORT=1883

# Name assigned to the Mosquitto container
MQTT_CONTAINER_NAME=legacy-link-mosquitto

# Dedicated Docker bridge network for inter-service communication
DOCKER_NETWORK_NAME=legacy-link-net

# --- Default Development Credentials ---
# Used by `./scripts/setup-mosquitto-auth.sh` and `./scripts/test-mqtt.sh`
MQTT_DEV_USER=legacy_admin
MQTT_DEV_PASS=legacy_secret_2026

# --- PostgreSQL Service ---
# Read ONLY on the first start of an empty data volume. After that Postgres
# ignores them entirely, so changing a value here does not migrate an existing
# database. Compose injects DATABASE_URL into both Node services.
# Use letters/digits and _ . ~ - here; URL delimiters are rejected by setup.
POSTGRES_CONTAINER_NAME=legacy-link-postgres

# Port bound on the host loopback interface only, so other machines on the LAN
# cannot reach the database.
POSTGRES_PORT=5432

POSTGRES_USER=legacy_admin
POSTGRES_PASS=change_me
POSTGRES_DB=legacy_link

# Consumer ghi heartbeat theo ID này; API phải dùng cùng ID để đọc đúng worker.
# Đừng đặt hai ID khác nhau chỉ vì đây là hai container khác nhau.
MQTT_CLIENT_ID=legacy-link-backend
# QoS backend dùng khi subscribe. Không nâng bản tin firmware publish ở QoS0 thành
# QoS một cách thần kỳ; xác nhận "database đã lưu" nằm ở ACK ứng dụng, không ở QoS.
MQTT_QOS=2
# 127.0.0.1 chỉ máy chạy Docker truy cập được; 0.0.0.0 mở API cho các máy trong LAN.
# ESP32 dùng LAN IP của broker, còn Node trong Docker dùng hostname mosquitto/postgres.
HTTP_BIND_ADDRESS=127.0.0.1
HTTP_PORT=3000
# Hai token cho API, phải KHÁC nhau và dài 32-128 ký tự hex.
# Để trống thì setup tự tạo; request phải gửi Authorization: Bearer <token>.
#   API_READ_TOKEN  -> chỉ đọc (GET/HEAD)
#   API_WRITE_TOKEN -> đọc và thao tác (POST); Nginx cũng dùng nó để chặn request ghi.
# Token thật chỉ nằm trong .env đã được Git bỏ qua, không điền vào file mẫu này.
API_READ_TOKEN=
API_WRITE_TOKEN=

# Origin frontend được phép gọi API, phân tách bằng dấu phẩy. Backend trả 403 nếu
# Origin của request thật không nằm trong danh sách; để trống nghĩa là không origin nào
# được phép. Gateway Nginx vẫn trả CORS * cho preflight.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Chỉ seed khi biết gateway ID thật 12 ký tự HEX hoa từ log/USB hoặc trạng thái gateway.
# MAC hiển thị thông thường và gateway ID firmware có thể khác thứ tự byte: không tự suy đoán.
BENCH_GATEWAY_ID=

# Dùng tên riêng nếu dựng stack kiểm thử song song, tránh đụng container đang demo.
CONSUMER_CONTAINER_NAME=legacy-link-consumer
API_CONTAINER_NAME=legacy-link-api
GATEWAY_CONTAINER_NAME=legacy-link-gateway
