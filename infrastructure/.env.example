# ==============================================================================
# [NOTE] Environment Configuration Template (.env.example)
#
# Role: Centralized environment variables for Docker Compose and helper scripts.
#
# Usage:
#   1. Copy this file to create your local `.env`:
#      cp .env.example .env
#   2. Adjust values if needed (ports, container names, dev credentials).
#   3. Never commit `.env` to Git (it is automatically ignored).
# ==============================================================================

# --- MQTT Broker Service ---
# Port exposed on the host machine for external clients (ESP32, simulators)
MQTT_PORT=1883

# Name assigned to the Mosquitto container
MQTT_CONTAINER_NAME=legacy-link-mosquitto

# Dedicated Docker bridge network for inter-service communication
DOCKER_NETWORK_NAME=legacy-link-net

# --- Default Development Credentials ---
# Used by `./scripts/setup-mosquitto-auth.sh` and `./scripts/test-mqtt.sh`
MQTT_DEV_USER=legacy_admin
MQTT_DEV_PASS=legacy_secret_2026

# --- PostgreSQL Service ---
# Read ONLY on the first start of an empty data volume. After that Postgres
# ignores them entirely, so changing a value here does not migrate an existing
# database. These must stay in sync with `DATABASE_URL` in `backend/.env`.
POSTGRES_CONTAINER_NAME=legacy-link-postgres

# Port bound on the host loopback interface only, so other machines on the LAN
# cannot reach the database.
POSTGRES_PORT=5432

POSTGRES_USER=legacy_admin
POSTGRES_PASS=change_me
POSTGRES_DB=legacy_link
